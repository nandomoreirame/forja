{
  "name": "forja",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "main": "out/main/index.js",
  "description": "An opinionated AI agent development environment built around the RPI workflow, from specification to review, with you in control of every stage.",
  "scripts": {
    "dev": "electron-vite dev",
    "dev:web": "vite --config vite.web.config.ts --host 127.0.0.1",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "dist": "npm run build && electron-builder --publish never",
    "dev:site": "vite --config site/vite.config.ts",
    "build:site": "vite build --config site/vite.config.ts && node site/scripts/prerender.ts",
    "deploy:site": "npm run build:site && node site/scripts/deploy.mjs",
    "preview:site": "vite preview --config site/vite.config.ts",
    "test:e2e:site": "playwright test --config site/playwright.config.ts",
    "format:check": "prettier --check 'site/**/*.{ts,tsx,css,html}' 'src/shared/{ui,styles,i18n}/**/*.{ts,tsx,css}' 'src/widgets/**/*.{ts,tsx}' 'test/web/**/*.{ts,tsx}' --no-error-on-unmatched-pattern",
    "test:coverage": "vitest run --coverage",
    "test:e2e:app": "playwright test --config test/app-e2e/playwright.config.ts",
    "test:desktop:picker": "npm run build && node test/desktop/project-directory.smoke.ts"
  },
  "build": {
    "appId": "dev.forja.app",
    "productName": "Forja",
    "directories": {
      "output": "dist"
    },
    "files": [
      "out/**",
      "package.json"
    ],
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Development"
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.developer-tools"
    }
  },
  "dependencies": {
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "cn": "^0.5.1",
    "lucide-react": "^1.65.0",
    "mermaid": "^12.2.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "5.0.5",
    "electron": "^45.2.0",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "eslint": "^10.14.0",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "prettier": "3.9.10",
    "shadcn": "4.23.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
